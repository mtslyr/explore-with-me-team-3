    {
      "name": "Подписки",
      "item": [
        {
          "name": "Подписка на пользователя",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const main = async () => {",
                  "    const api = new API(pm);",
                  "    const rnd = new RandomUtils();",
                  "",
                  "    try {",
                  "        const userA = await api.addUser(rnd.getUser());",
                  "        pm.collectionVariables.set(\"userId\", userA.id)",
                  "",
                  "        const userB = await api.addUser(rnd.getUser());",
                  "        pm.collectionVariables.set(\"targetUserId\", userB.id)",
                  "    } catch(err) {",
                  "        console.error(\"Ошибка при подготовке тестовых данных.\", err);",
                  "    }",
                  "};",
                  "",
                  "const interval = setInterval(() => {}, 1000);",
                  "",
                  "setTimeout(async () => ",
                  "    {",
                  "        try {",
                  "            await main();",
                  "        } catch (e) {",
                  "            console.error(e);",
                  "        } finally {",
                  "            clearInterval(interval);",
                  "        }",
                  "    },  ",
                  "    100 ",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус код 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.have.body;",
                  "    pm.response.to.be.json;",
                  "})",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Проверка данных пользователей\", function () {",
                  "    pm.expect(response.follower.id).to.be.eql(pm.variables.get(\"userId\"));",
                  "    pm.expect(response.followed.id).to.be.eql(pm.variables.get(\"targetUserId\"));",
                  "    pm.expect(response.status).to.be.eql(\"PENDING\");",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"targetUserId\": {{targetUserId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "subscriptions"
              ]
            }
          },
          "response": []
        },
