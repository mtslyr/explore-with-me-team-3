            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const main = async () => {",
                  "    const api = new API(pm);",
                  "    const rnd = new RandomUtils();",
                  "",
                  "    try {",
                  "        const userA = await api.addUser(rnd.getUser());",
                  "        pm.collectionVariables.set(\"userId\", userA.id)",
                  "",
                  "        const userB = await api.addUser(rnd.getUser());",
                  "        pm.collectionVariables.set(\"userBId\", userB.id);",
                  "",
                  "        // подписываем пользователя А на пользователя Б",
                  "        const sub = await api.requestSubscribe(userA.id, userB.id);",
                  "        await api.confirmSubscription(sub.id, userB.id);",
                  "",
                  "        // создаем 3 пользователя",
                  "        const userC = await api.addUser(rnd.getUser());",
                  "        pm.collectionVariables.set(\"userCId\", userC.id);",
                  "",
                  "        // публикуем событие пользователя Б",
                  "        const category = await api.addCategory(rnd.getCategory());",
                  "        pm.collectionVariables.set(\"catId\", category.id);",
                  "        const eventB = await api.addEvent(userB.id, rnd.getEvent(category.id));",
                  "        await api.publishEvent(eventB.id);",
                  "",
                  "",
                  "        // публикуем событие пользователя С",
                  "        const eventC = await api.addEvent(userC.id, rnd.getEvent(category.id));",
                  "        await api.publishEvent(eventC.id);",
                  "",
                  "        // Добавляем просмотров событию С",
                  "        await api.findEvent(eventC.id);",
                  "        await api.findEvent(eventC.id);",
                  "",
                  "    } catch(err) {",
                  "        console.error(\"Ошибка при подготовке тестовых данных.\", err);",
                  "    }",
                  "",
                  "    pm.request.body.update({",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify(event),",
                  "        options: { raw: { language: 'json' } }",
                  "    });",
                  "};",
                  "",
                  "const interval = setInterval(() => {}, 1000);",
                  "",
                  "setTimeout(async () => ",
                  "    {",
                  "        try {",
                  "            await main();",
                  "        } catch (e) {",
                  "            console.error(e);",
                  "        } finally {",
                  "            clearInterval(interval);",
                  "        }",
                  "    },  ",
                  "    100 ",
                  ");"
                ],
